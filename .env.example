# Server only. Never put secrets in VITE_* variables or commit a real .env file.
API_HOST=0.0.0.0
API_PORT=8787

# Leave DATABASE_URL empty to use local PGlite PostgreSQL in .data/pglite.
# Set it to a managed PostgreSQL URL for production.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Optional licensed/official providers. Missing keys stay NOT CONFIGURED.
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SERPAPI_API_KEY=
SERPAPI_COST_PER_CALL_USD=0.01

# Optional. Email delivery is not wired; without SMTP_URL, verification uses a local mailbox token.
SMTP_URL=
AUTH_SECRET=
ADMIN_TOKEN=
APP_ORIGIN=
COOKIE_SECURE=auto

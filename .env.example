# Server only. Never put secrets in VITE_* variables or commit a real .env file.
API_HOST=0.0.0.0
API_PORT=8787

# Leave DATABASE_URL empty to use local PGlite PostgreSQL in .data/pglite.
# Set it to a managed PostgreSQL URL for production.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Optional licensed/official providers. Missing keys stay NOT CONFIGURED.
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SERPAPI_API_KEY=
SERPAPI_COST_PER_CALL_USD=0.01

# Real verification email through Resend. Local mailbox only outside production.
EMAIL_API_KEY=
EMAIL_FROM=
SEARCH_INTEREST_PROVIDER=serpapi
# Local embedded worker only. With PostgreSQL run npm run worker separately.
BACKGROUND_COLLECTION=false
# Daily call budgets shared by foreground and background jobs. Failed calls count.
PROVIDER_DAILY_CALLS_YOUTUBE=198
PROVIDER_DAILY_CALLS_REDDIT=200
PROVIDER_DAILY_CALLS_SEARCH=40
PROVIDER_DAILY_CALLS_NEWS=200
PROVIDER_DAILY_CALLS_WIKIPEDIA=200
PROVIDER_DAILY_CALLS_HACKERNEWS=200
# Set only when an ingress removes/replaces incoming forwarding headers.
TRUST_PROXY=false
AUTH_SECRET=
ADMIN_TOKEN=
APP_ORIGIN=
COOKIE_SECURE=auto
